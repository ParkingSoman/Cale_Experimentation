+// Cale: undo repack_q4_0_to_q4_0_{4,8}_bl. NB rows are interleaved, INTER bytes at a time. Threads split the row groups.
+template <int NB, int INTER>
+static int unrepack_q4_0(const struct ggml_tensor * t, void * out_v, size_t out_size) {
+    using packed_t = typename std::conditional<NB == 4, block_q4_0x4, block_q4_0x8>::type;
+    const int64_t nblocks = t->ne[0] / QK4_0;
+    const int64_t nrow    = ggml_nrows(t);
+    if (out_size != (size_t) (nrow * nblocks) * sizeof(block_q4_0) || nrow % NB != 0 || t->ne[0] % 8 != 0) {
+        return -1;
+    }
+    const packed_t * src = (const packed_t *) t->data;
+    block_q4_0 *     dst = (block_q4_0 *) out_v;
+    const int64_t groups = nrow / NB;
+    const int     end    = QK4_0 * (NB / 2) / INTER;
+    auto work = [&](int64_t g0, int64_t g1) {
+        for (int64_t g = g0; g < g1; g++) {
+            for (int64_t x = 0; x < nblocks; x++) {
+                const packed_t & p    = src[g * nblocks + x];
+                block_q4_0 *     rows = dst + (g * NB) * nblocks + x;
+                for (int i = 0; i < NB; i++) {
+                    rows[i * nblocks].d = p.d[i];
+                }
+                for (int i = 0; i < end; ++i) {
+                    const int src_id = i % NB;
+                    const int src_offset = (i / NB) * INTER;
+                    const int dst_offset = i * INTER;
+                    if (INTER == 8) {
+                        uint64_t e;
+                        memcpy(&e, &p.qs[dst_offset], sizeof(e));
+                        e ^= 0x8888888888888888ULL;
+                        memcpy(&rows[src_id * nblocks].qs[src_offset], &e, sizeof(e));
+                    } else {
+                        uint32_t e;
+                        memcpy(&e, &p.qs[dst_offset], sizeof(e));
+                        e ^= 0x88888888U;
+                        memcpy(&rows[src_id * nblocks].qs[src_offset], &e, sizeof(e));
+                    }
+                }
+            }
+        }
+    };
+    const int64_t bytes = (int64_t) out_size;
+    int n_threads = bytes < (1 << 20) ? 1 : (int) std::min<int64_t>(4, std::max<int64_t>(1, (int64_t) std::thread::hardware_concurrency()));
+    if (n_threads <= 1 || groups < n_threads) {
+        work(0, groups);
+    } else {
+        std::vector<std::thread> pool;
+        const int64_t per = (groups + n_threads - 1) / n_threads;
+        for (int k = 1; k < n_threads; k++) {
+            const int64_t a = std::min(groups, k * per), b = std::min(groups, (k + 1) * per);
+            if (a < b) pool.emplace_back(work, a, b);
+        }
+        work(0, std::min(groups, per));
+        for (auto & th : pool) th.join();
+    }
+    return 0;
+}
