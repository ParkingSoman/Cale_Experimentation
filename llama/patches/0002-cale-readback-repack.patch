+    // Cale: the inverse of repack. Writes the plain block layout of the whole tensor to `out`. Returns 0, or -1 if this layout cannot be read back.
+    virtual int unrepack(const struct ggml_tensor * t, void * out, size_t out_size) const { GGML_UNUSED(t); GGML_UNUSED(out); GGML_UNUSED(out_size); return -1; }
