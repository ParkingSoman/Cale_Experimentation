+// Cale: a repacked weight can be read back in its plain layout. The scheduler uses this to let a GPU read the prompt with weights that stay
+// repacked in RAM for the CPU (which answers fast). Only whole tensors are read.
+static void ggml_backend_cpu_repack_buffer_get_tensor(ggml_backend_buffer_t buffer, const struct ggml_tensor * tensor,
+                                                       void * data, size_t offset, size_t size) {
+    GGML_ASSERT(offset == 0);
+    GGML_ASSERT(size == ggml_nbytes(tensor));
+
+    auto tensor_traits = (ggml::cpu::repack::tensor_traits_base *) tensor->extra;
+    GGML_ASSERT(tensor_traits != nullptr);
+    GGML_ASSERT(tensor_traits->unrepack(tensor, data, size) == 0);
+    GGML_UNUSED(buffer);
+}
