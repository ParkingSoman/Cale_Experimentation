+int32_t llama_set_layer_widths(llama_context * ctx, const int32_t * ffn_width, int32_t n_layers) {
+    return ctx->set_layer_widths(ffn_width, n_layers);
+}
+
+const ggml_tensor * llama_model_get_tensor(const llama_model * model, const char * name) {
