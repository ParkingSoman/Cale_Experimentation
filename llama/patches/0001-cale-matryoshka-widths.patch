+int32_t llama_context::set_layer_widths(const int32_t * ffn_width, int32_t n_layers) {
+    if (n_layers == 0 || ffn_width == nullptr) {
+        cparams.ffn_width.clear();
+    } else {
+        if (n_layers != (int32_t) model.hparams.n_layer()) {
+            return -1;
+        }
+        cparams.ffn_width.assign(ffn_width, ffn_width + n_layers);
+    }
+    gf_res_prev_active = nullptr; // the next call builds a new graph
+    return 0;
+}
